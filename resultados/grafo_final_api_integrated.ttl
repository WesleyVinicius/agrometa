agrometa:hasClimaticContext a owl:ObjectProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range iso19115:MD_Metadata .

agrometa:hasEventDate a owl:DatatypeProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range xsd:string .

agrometa:hasInstitution a owl:DatatypeProperty ;
    rdfs:domain iso19115:MD_Metadata ;
    rdfs:range xsd:string .

