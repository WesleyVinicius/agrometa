    rdfs:domain dwc:Occurrence ;
    rdfs:range xsd:float .

agrometa:hasLineage a owl:DatatypeProperty ;
    rdfs:domain iso19115:MD_Metadata ;
    rdfs:range xsd:string .

agrometa:hasLongitude a owl:DatatypeProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range xsd:float .

agrometa:hasMeteorologicalRecord a owl:ObjectProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range wcmp2:Record .

agrometa:hasObservedProperty a owl:DatatypeProperty ;
    rdfs:domain wcmp2:Record ;
    rdfs:range xsd:string .

agrometa:hasScientificName a owl:DatatypeProperty ;
    rdfs:domain dwc:Occurrence ;
    rdfs:range xsd:string .

agrometa:hasStationID a owl:DatatypeProperty ;
    rdfs:domain wcmp2:Record ;
    rdfs:range xsd:string .

agro:affects a owl:ObjectProperty .

time:Instant a owl:Class ;
    rdfs:subClassOf time:TemporalEntity .

time:Interval a owl:Class ;
    rdfs:subClassOf time:TemporalEntity .

